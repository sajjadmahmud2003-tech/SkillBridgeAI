# ==========================================
# SkillBridge AI — Environment Configuration
# ==========================================

# Supabase (Database, Auth, and pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider (Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key
AI_EMBEDDING_MODEL=text-embedding-004

# GitHub Integration (Optional - for higher rate limits on public repo analysis)
GITHUB_TOKEN=your-github-personal-access-token

# Application Mode
# Set to 'true' to explicitly enable demo fallbacks even when keys are present
NEXT_PUBLIC_DEMO_MODE=false
